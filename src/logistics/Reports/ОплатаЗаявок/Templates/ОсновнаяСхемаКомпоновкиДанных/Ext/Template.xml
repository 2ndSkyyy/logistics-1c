		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    Заявка.Ссылка КАК Заявка,
    Заявка.Номер КАК Номер,
    Заявка.Дата КАК Дата,
    Заявка.Контрагент КАК Заказчик,
    Заявка.Отдел КАК Отдел,
    Заявка.Логист КАК Логист,
    Заявка.СуммаЗаявки КАК СуммаЗаявки,
    Заявка.СуммаОплаты КАК Оплачено,
    Заявка.СальдоКонечное КАК Остаток,
    ВЫБОР
        КОГДА Заявка.СальдоКонечное &gt; 0
            ТОГДА "Неоплаченные"
        ИНАЧЕ "Оплаченные"
    КОНЕЦ КАК СтатусОплаты
ИЗ
    Документ.Заявка КАК Заявка
ГДЕ
    НЕ Заявка.ПометкаУдаления
    И Заявка.Дата &gt;= НАЧАЛОПЕРИОДА(&amp;НачалоПериода, ДЕНЬ)
    И Заявка.Дата &lt;= КОНЕЦПЕРИОДА(&amp;КонецПериода, ДЕНЬ)</query>
