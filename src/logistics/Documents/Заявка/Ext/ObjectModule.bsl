Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	    // Проверяем последовательность дат, если обе заполнены.
    Если ЗначениеЗаполнено(Загрузка_Дата)
        И ЗначениеЗаполнено(Выгрузка_Дата) Тогда

        Если Выгрузка_Дата < Загрузка_Дата Тогда

            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст =
                "Дата выгрузки не может быть раньше даты загрузки.";
            Сообщение.Поле = "Выгрузка_Дата";
            Сообщение.УстановитьДанные(ЭтотОбъект);
            Сообщение.Сообщить();

            Отказ = Истина;
            Возврат;

        КонецЕсли;

	КонецЕсли;
	
	    // Проверяем владельца выбранного договора.
    Если ЗначениеЗаполнено(Договор) Тогда

        Если Не ЗначениеЗаполнено(Контрагент) Тогда

            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст =
                "Укажите заказчика, которому принадлежит договор.";
            Сообщение.Поле = "Контрагент";
            Сообщение.УстановитьДанные(ЭтотОбъект);
            Сообщение.Сообщить();

            Отказ = Истина;
            Возврат;

        КонецЕсли;

        Если Договор.Владелец <> Контрагент Тогда

            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст =
                "Выбранный договор принадлежит другому заказчику. Выберите договор указанного заказчика.";
            Сообщение.Поле = "Договор";
            Сообщение.УстановитьДанные(ЭтотОбъект);
            Сообщение.Сообщить();

            Отказ = Истина;
            Возврат;

        КонецЕсли;

    КонецЕсли;
	
    // Оплаты заказчика и остаток задолженности.
    СуммаОплаты = Оплаты.Итог("Сумма");
    СальдоКонечное = СуммаЗаявки - СуммаОплаты;

    // Стоимость перевозки без НДС.
    Если БезНДС Тогда
        СуммаЗаявкиБезНДС = СуммаЗаявки;
    Иначе
        СуммаЗаявкиБезНДС = Окр(
            СуммаЗаявки / (1 + СтавкаНДС / 100), 2);
    КонецЕсли;

    // Сумма исполнителя без НДС.
    Если ИсполнительБезНДС Тогда
        СуммаИсполнителяБезНДС = СуммаИсполнителя;
    Иначе
        СуммаИсполнителяБезНДС = Окр(
            СуммаИсполнителя / (1 + СтавкаНДСИсполнителя / 100), 2);
    КонецЕсли;

    // Разница между суммами без НДС.
    ЧистаяДельта = СуммаЗаявкиБезНДС - СуммаИсполнителяБезНДС;

КонецПроцедуры